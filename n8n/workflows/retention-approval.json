        "formDescription": "={{\n  'Customer: '\n  + $('When Executed by Another Workflow').first().json.customer_id\n  + '\\nCase ID: '\n  + $('When Executed by Another Workflow').first().json.case_id\n  + '\\nSimulation round: '\n  + $('When Executed by Another Workflow').first().json.round_id\n  + '\\nSynthetic churn risk: '\n  + (\n      $('When Executed by Another Workflow')\n        .first().json.churn_probability * 100\n    ).toFixed(1) + '%'\n  + '\\nProposed discount: '\n  + $('When Executed by Another Workflow')\n      .first().json.proposed_discount_percent + '%'\n  + '\\n\\nApprove or reject this retention offer.'\n}}",
